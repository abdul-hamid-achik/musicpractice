{
  "name": "music-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint --vue-plugin --import-plugin .",
    "lint:fix": "oxlint --vue-plugin --import-plugin --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tools": "vp",
    "behaviors": "task -d tests/behaviors",
    "behaviors:doctor": "task -d tests/behaviors doctor",
    "behaviors:setup": "task -d tests/behaviors setup",
    "behaviors:test": "task -d tests/behaviors test",
    "behaviors:run": "task -d tests/behaviors run",
    "behaviors:perf": "task -d tests/behaviors perf",
    "behaviors:perf-suite": "task -d tests/behaviors perf-suite",
    "behaviors:cleanup": "task -d tests/behaviors cleanup",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run server/db/seed.ts"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.7.1",
    "@pinia/nuxt": "^0.9.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.0",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.0",
    "postgres": "^3.4.0",
    "tone": "^15.1.0",
    "vexflow": "^5.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.30.0",
    "happy-dom": "^16.0.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.47.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "unplugin-auto-import": "^21.0.0",
    "vite-plus": "^0.1.24",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.9"
  }
}
